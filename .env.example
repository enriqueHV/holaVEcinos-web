# URL pública del sitio para canonical, sitemap y OG.
VITE_SITE_URL="https://holavecinos.app"

# Origen de la app (`holaVEcinos (app)/Frontend`). Login = `${VITE_APP_URL}/login`.
# Local: http://localhost:5173  |  Producción: URL real del frontend de la app.
VITE_APP_URL="http://localhost:5173"
# VITE_APP_REGISTER_URL="http://localhost:5173/register"
# VITE_APP_LOGIN_URL="http://localhost:5173/login"

# Endpoint del formulario (en dev se atiende localmente en /api/contact).
VITE_CONTACT_ENDPOINT="/api/contact"

# Email receptor de prospectos.
CONTACT_TO_EMAIL="esucre@holavecinos.app"

# Resend
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="holaVEcinos <noreply@holavecinos.app>"

# Opcional: límite por IP (cantidad de envíos por ventana).
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_MS="3600000"
